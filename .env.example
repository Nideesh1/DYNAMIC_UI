# Gemini API key from a project with billing enabled (aistudio.google.com/apikey).
# Free tier caps gemini-3-flash at 20 requests/day and File Search storage is small.
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides
# OPENUI_PROMPT_PATH=frontend/src/generated/system-prompt.txt
# FALKOR_HOST=localhost
# FALKOR_PORT=6379
# CB6_EMBED_BACKEND=fastembed   # or "gemini" (requires full graph rebuild)

# --- agent observatory (docker compose --profile observatory) ---
# Generate these with: ./scripts/gen-obs-env.sh  (Langfuse/ClickHouse/Redis secrets)
# OBS_CLICKHOUSE_PASSWORD=  OBS_LANGFUSE_REDIS_AUTH=  OBS_NEXTAUTH_SECRET=  OBS_SALT=  OBS_ENCRYPTION_KEY=
# OBS_LANGFUSE_PUBLIC_KEY=  OBS_LANGFUSE_SECRET_KEY=  OBS_LANGFUSE_PASSWORD=
# OBS_HATCHET_TOKEN=   # for running the worker on the host (in docker it's read from the obs_hatchet_token volume)
