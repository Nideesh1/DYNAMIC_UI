# Copy to .env (never commit .env). Used by docker compose and by the example when run on the host.

# --- example agents (examples/deepagents-hatchet) ---
# LLM for the example agents: "<provider>:<model>" (LangChain init_chat_model). Set the matching key below.
# AGENT_MODEL=google_genai:gemini-3.8-flash      # default
# AGENT_MODEL=anthropic:claude-sonnet-5-5
# AGENT_MODEL=openai:gpt-5-mini
# Only the key for the provider you pick is needed.
# Gemini: aistudio.google.com/apikey (project with billing enabled)
GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# --- AgentGlow ---
# Where agentglow.watch() sends spans. Host dev: http://localhost:8100 (compose sets http://agentglow:8100).
AGENTGLOW_URL=http://localhost:8100

# --- Hatchet (host dev only; in docker the worker reads the token from the obs_hatchet_token volume) ---
# ./scripts/gen-obs-env.sh fills this once the Hatchet stack has minted its token (docker compose up)
# OBS_HATCHET_TOKEN=

# --- Langfuse (optional, only for: docker compose --profile langfuse up -d — plain `docker compose up` needs none of this) ---
# Generate all of these with: ./scripts/gen-obs-env.sh   (appends random values to .env, never prints them)
# When the two OBS_LANGFUSE_*_KEY values are set, the example also exports spans to Langfuse
# (set LANGFUSE_EXPORT=0 to turn that off; in compose it is off unless LANGFUSE_EXPORT=1).
# OBS_CLICKHOUSE_PASSWORD=
# OBS_LANGFUSE_REDIS_AUTH=
# OBS_NEXTAUTH_SECRET=
# OBS_SALT=
# OBS_ENCRYPTION_KEY=
# OBS_LANGFUSE_PUBLIC_KEY=
# OBS_LANGFUSE_SECRET_KEY=
# OBS_LANGFUSE_PASSWORD=
# LANGFUSE_EXPORT=1
